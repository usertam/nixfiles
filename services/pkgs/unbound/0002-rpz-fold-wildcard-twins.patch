+/**
+ * A wildcard trigger "*.<name>" that has the same action as the trigger for
+ * "<name>" is not stored as a zone of its own. It is folded into the zone
+ * for "<name>", by setting rpz_wildcard on it. Blocklists commonly list
+ * every domain twice like that. Only action-only zones (no local data)
+ * are folded. If a zone has rpz_wildcard set, there is no zone "*.<name>".
+ * The caller holds the lz lock for writing, and no zone locks.
+ * @return true if the wildcard is now covered by its parent zone (also if
+ *	it already was, the record is then a duplicate).
+ */
+static int
+rpz_fold_wildcard(struct local_zones* lz, uint8_t* dname, size_t dnamelen,
+	int dnamelabs, enum rpz_action a)
+{
+	struct local_zone* p;
+	int folded;
+	if(dnamelen <= 2 || !dname_is_wild(dname))
+		return 0;
+	p = local_zones_find(lz, dname+2, dnamelen-2, dnamelabs-1,
+		LDNS_RR_CLASS_IN);
+	if(!p)
+		return 0;
+	lock_rw_wrlock(&p->lock);
+	folded = p->rpz_wildcard;
+	if(!folded && a != RPZ_LOCAL_DATA_ACTION &&
+		p->type == rpz_action_to_localzone_type(a) &&
+		p->data.count == 0) {
+		p->rpz_wildcard = 1;
+		folded = 1;
+	}
+	lock_rw_unlock(&p->lock);
+	return folded;
+}
+
+/**
+ * The zone z was just created for an action-only trigger. If the wildcard
+ * for it was inserted earlier, as a zone of its own with the same action,
+ * fold that into z. The caller holds the lz lock for writing, and no zone
+ * locks.
+ */
+static void
+rpz_fold_existing_wildcard(struct local_zones* lz, struct local_zone* z)
+{
+	uint8_t wc[LDNS_MAX_DOMAINLEN+1];
+	struct local_zone* w;
+	int same;
+	if(z->namelen+2 > sizeof(wc) || dname_is_wild(z->name))
+		return;
+	wc[0] = 1; /* length of wildcard label */
+	wc[1] = (uint8_t)'*'; /* wildcard label */
+	memmove(wc+2, z->name, z->namelen);
+	w = local_zones_find(lz, wc, z->namelen+2, z->namelabs+1,
+		LDNS_RR_CLASS_IN);
+	if(!w)
+		return;
+	lock_rw_rdlock(&w->lock);
+	/* z is not visible to other threads yet, lz is write locked */
+	same = (w->type == z->type && w->data.count == 0);
+	lock_rw_unlock(&w->lock);
+	if(!same)
+		return;
+	local_zones_del_zone(lz, w);
+	lock_rw_wrlock(&z->lock);
+	z->rpz_wildcard = 1;
+	lock_rw_unlock(&z->lock);
+}
+
+/**
+ * The zone "<name>" is removed, but it had the wildcard folded into it and
+ * that stays. Give the wildcard a zone of its own. The caller holds the lz
+ * lock for writing, and no zone locks.
+ */
+static void
+rpz_unfold_wildcard(struct local_zones* lz, struct local_zone* z,
+	enum localzone_type tp)
+{
+	uint8_t* wc;
+	if(z->namelen+2 > LDNS_MAX_DOMAINLEN)
+		return;
+	wc = (uint8_t*)malloc(z->namelen+2);
+	if(!wc) {
+		log_err("malloc failure in rpz wildcard unfold");
+		return;
+	}
+	wc[0] = 1; /* length of wildcard label */
+	wc[1] = (uint8_t)'*'; /* wildcard label */
+	memmove(wc+2, z->name, z->namelen);
+	/* wc is owned by the new zone, or freed on failure */
+	if(!local_zones_add_zone(lz, wc, z->namelen+2, z->namelabs+1,
+		z->dclass, tp))
+		log_warn("rpz: create failed");
+}
